+    \node [commit, right=of c2] (c3) {C3};
+    \node [commit, right=of c3] (m1) {M1};
+    
+    % Feature branch
+    \node [commit_feature, above right=1cm and 0.5cm of c2] (f1) {F1};
+    \node [commit_feature, right=of f1] (f2) {F2};
+    
+    % Connections
+    \draw [arrow] (c1) -- (c2);
