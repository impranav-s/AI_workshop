+% Original slide worktrees
+\begin{frame}[fragile]{Git Worktrees: Separate Folders for Parallel Work}
+\begin{columns}[t]
+\begin{column}{0.48\textwidth}
+\textbf{What is a Worktree?}
+\begin{itemize}\setlength{\itemsep}{0pt}
+    \item Another working folder attached to the same repository
+    \item Check out a different branch in each folder
+    \item Shared Git history; separate files and staging areas
+\end{itemize}
+\vspace{0.2cm}
+\textbf{Working with AI Agents:}
+\begin{itemize}\setlength{\itemsep}{0pt}
+    \item One named session and worktree per task
+    \item Parallel agents edit separate working copies
+    \item Review and merge their branches when ready
+\end{itemize}
+\end{column}
+\begin{column}{0.48\textwidth}
+\textbf{Basic Commands:}
+\begin{block}{Create a Branch and Working Folder}
+\small
+\begin{verbatim}
+git worktree add -b task-a ../task-a
+\end{verbatim}
+\end{block}
+\begin{block}{List Working Folders}
+\small
+\begin{verbatim}
+git worktree list
+\end{verbatim}
+\end{block}
+\begin{block}{Remove a Clean Working Folder}
+\small
+\begin{verbatim}
+git worktree remove ../task-a
+\end{verbatim}
+\end{block}
+\end{column}
+\end{columns}
+\end{frame}
+
+
+% Original slide 27
+\begin{frame}{Git Best Practices}
+\begin{block}{Commit Messages}
+\begin{itemize}
+    \item Be descriptive: "Add regression analysis for Model 2"
+    \item Use imperative mood: "Fix data loading bug"
+    \item Reference issues: "Closes \#42"
+\end{itemize}
+\end{block}
+
+\begin{block}{What to Commit}
+\begin{itemize}
+    \item \textcolor{green}{DO}: Source code, scripts, documentation
+    \item \textcolor{green}{DO}: Raw sample data (if reasonable size)
+    \item \textcolor{red}{DON'T}: Unneeded generated outputs (rebuild from scripts)
+    \item \textcolor{red}{DON'T}: Large binary files (use Git LFS if needed)
+    \item \textcolor{red}{DON'T}: Passwords or API keys
+\end{itemize}
+\end{block}
+
+% \begin{block}{Commit Frequency}
+% \begin{itemize}
+%     \item Commit often (atomic commits)
+%     \item Each commit = one logical change
+%     \item Makes history easier to understand
+% \end{itemize}
+% \end{block}
+\end{frame}
+
+
+% Original slide 28
+\begin{frame}[fragile]{The .gitignore File}
+\textbf{What is .gitignore?}
+\begin{itemize}
+    \item Tells Git which untracked files to ignore
+    \item Helps exclude generated files, credentials, or large binaries
+    \item Usually at the root; subdirectories can have their own
+\end{itemize}
+
+\vspace{0.2cm}
+
+\textbf{Example .gitignore for Research Projects:}
+\begin{columns}
+\begin{column}{0.48\textwidth}
+\scriptsize
+\begin{verbatim}
+# Python
+__pycache__/
+*.pyc
+.ipynb_checkpoints/
+*.egg-info/
+
+# R
+.Rhistory
+.RData
+.Rproj.user/
+
+\end{verbatim}
+\end{column}
+
+\begin{column}{0.48\textwidth}
+\scriptsize
+\begin{verbatim}
+# LaTeX
+*.aux
+*.bbl
+*.blg
+*.log
+*.out
+*.fls
+*.synctex.gz
+
+# Generated outputs
+output/
+*.pdf
+*.png
+\end{verbatim}
+\end{column}
+\end{columns}
+
+% \vspace{0.2cm}
+% \textbf{Pro tip:} Use \url{gitignore.io} to generate templates for your language/tools!
+\end{frame}
+
+
+% Original slide 29
+\begin{frame}{Common Challenges \& Solutions}
+
+\textbf{Understanding Merge Conflicts:}
+\begin{itemize}
+    \item Occur when Git cannot automatically determine which version to keep
+    \item Happen when the same lines of code/text are edited in different branches
+    \item VS Code highlights conflicts and lets you choose which version to keep
+    \item AI agents can suggest the best resolution strategy!
+\end{itemize}
+
+\vspace{0.2cm}
+
+\textbf{Backing Up Your Work:}
+\begin{itemize}
+    \item You can keep your local repo in Dropbox for automatic backup
+    \item Avoid sharing that Dropbox folder with co-authors unless you can really coordinate well
+    % \item Use GitHub for collaboration, Dropbox only for personal backup
+\end{itemize}
+
+\vspace{0.2cm}
+
+\begin{table}
+\scriptsize
+\begin{tabular}{lp{6.5cm}}
+\toprule
+\textbf{Challenge} & \textbf{Solution} \\
+\midrule
+Merge conflicts & Use VS Code conflict resolver, ask AI agent for help \\
+Large files & Use .gitignore, Git LFS if needed \\
+Slow Git operations & Use .gitignore for generated files \\
+Lost work & Commit often, use branches \\
+Unclear AI output & Refine prompts, add context \\
+Reproducibility & Use Makefile, document dependencies \\
+\bottomrule
+\end{tabular}
+\end{table}
+\end{frame}
+
+
+% Original slide 30
+\begin{frame}{Resolving Merge Conflicts in VS Code}
+\begin{center}
+\includegraphics[width=0.5\textwidth]{figures/merge_conflict.png}
+\end{center}
+
+\vspace{0.2cm}
+\begin{itemize}\setlength{\itemsep}{2pt}
+    \item VS Code shows \textbf{conflict markers}: \texttt{<<<<<<< HEAD} (yours) vs \texttt{>>>>>>> theirs}
+    \item One-click options: \textit{Accept Current}, \textit{Accept Incoming}, \textit{Accept Both}, or \textit{Compare}
+    \item Use \textbf{Resolve in Merge Editor} for a side-by-side 3-way diff
+\end{itemize}
+\end{frame}
